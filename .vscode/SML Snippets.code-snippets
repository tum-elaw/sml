	"Zitat inline": {
		"prefix": "Zitat inline",
		"body": ["<span class='tooltip'><sup><a id='1.1'>[[1]](#1)</a></sup><span class='tooltiptext'>Quelle</span></span>"],
		"description": "Zitat inline",
		"scope": "markdown"
	  },

	"Zitat back": {
		"prefix": "Zitat back",
		"body": ["<a id='1'>[[1]](#1.1)</a>"],
		"description": "Zitat link back to text",
		"scope": "markdown"
	  },

	"tooltip": {
		"prefix": "tooltip",
		"body": [
		  "<style>",
		  "/* Tooltip container */",
		  ".tooltip {",
		  "  position: relative;",
		  "  display: inline-block;",
		  "}",
		  "",
		  "/* Tooltip text */",
		  ".tooltip .tooltiptext {",
		  "  position: absolute;",
		  "  width: max-content;",
		  "  max-width: 2000%;",
		  "  visibility: hidden;",
		  "  background-color: #555;",
		  "  color: #fff;",
		  "  text-align: center;",
		  "  padding: 5px 5px;",
		  "  border-radius: 6px;",
		  "",
		  "  /* Position the tooltip text */",
		  "  position: absolute;",
		  "  z-index: 1;",
		  "  bottom: 125%;",
		  "  left: 50%;",
		  "  margin-left: -60px;",
		  "",
		  "  /* Fade in tooltip */",
		  "  opacity: 0;",
		  "  transition: opacity 0.3s;",
		  "}",
		  "",
		  "/* Show the tooltip text when you mouse over the tooltip container */",
		  ".tooltip:hover .tooltiptext {",
		  "  visibility: visible;",
		  "  opacity: 1;",
		  "}",
		  "</script>"
		],
		"description": "tooltip"
	  }
}