	"Zitat inline": {
		"prefix": "Zitat inline",
		"body": ["<span class='tooltip'><sup><a id='1.1'>[[1]](#1)</a></sup><span class='tooltiptext'>Quelle</span></span>"],
		"description": "Zitat inline",
		"scope": "markdown"
	  },

	"Zitat back": {
		"prefix": "Zitat back",
